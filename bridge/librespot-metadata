#!/usr/bin/env python3
"""Feed librespot's playback events into owntone as Shairport metadata.

librespot runs this program on every player event (`--onevent`) and hands it the
event in the environment. owntone, reading PCM audio from a named pipe, also
watches `<pipe>.metadata` for metadata in the format shairport-sync writes. This
turns the first into the second, which is the only way a pipe input ever gets a
title, an artist or cover art.

    TUTTI_AUDIO_PIPE=/path/to/spotify.fifo \
    librespot --backend pipe --device /path/to/spotify.fifo \
              --onevent /path/to/librespot-metadata ...

Run once with --setup before starting owntone, so the metadata pipe exists by
the time owntone looks for it.

Nothing here talks to Spotify. Every field comes out of librespot's environment,
except the cover image, which is fetched from the URL librespot supplies.

Constraints this encodes, all read out of owntone's src/inputs/pipe.c:

- Items are Shairport XML: type and code are 8-hex-digit DMAP four-char codes,
  payload is base64. owntone acts on minm, asar, asal, asgn, prgr, pvol, PICT
  and pfls, and ignores everything else.
- prgr is measured in FRAMES, not milliseconds: owntone computes
  pos_ms = (pos - start) * 1000 / pipe_sample_rate. The sample rate here must
  match owntone's library.pipe_sample_rate (default 44100).
- prgr is rejected outright if any of start/pos/end is zero, so frame numbers
  here are 1-based.
- PICT carries raw image bytes, JPEG or PNG only, 2 bytes to 1 MiB. librespot
  gives cover URLs, so the image has to be fetched before it can be sent.
- owntone only starts watching the metadata pipe once playback begins, so
  writing when nothing is reading is normal and not an error.

Volume is deliberately not forwarded. Spotify's volume and the AirPlay output
volume are separate controls, and feeding one into the other invites a loop.
"""

import argparse
import base64
import errno
import json
import os
import select
import sys
import time
import urllib.request

# owntone's PIPE_PICTURE_SIZE_MAX.
PICTURE_SIZE_MAX = 1048576
# owntone's default library.pipe_sample_rate.
DEFAULT_SAMPLE_RATE = 44100

# DMAP type codes: "core" carries the track text, "ssnc" the Shairport extras.
TYPE_CORE = "core"
TYPE_SSNC = "ssnc"

CODE_TITLE = "minm"
CODE_ARTIST = "asar"
CODE_ALBUM = "asal"
CODE_GENRE = "asgn"
CODE_PROGRESS = "prgr"
CODE_PICTURE = "PICT"
CODE_FLUSH = "pfls"


def fourcc(code):
    """A DMAP four-char code as the 8 hex digits owntone parses with %8x."""
    return code.encode("ascii").hex()


def item(type_code, code, payload=None):
    """One Shairport metadata item.

    Layout copied from the worked example in owntone's pipe.c: the newline
    before the base64 payload is part of the format shairport emits, and
    owntone's extractor splits on `</item>` regardless.
    """
    head = "<item><type>%s</type><code>%s</code>" % (fourcc(type_code), fourcc(code))
    if payload is None:
        return ("%s<length>0</length></item>" % head).encode("utf-8")

    encoded = base64.b64encode(payload).decode("ascii")
    return ("%s<length>%d</length>\n<data encoding=\"base64\">\n%s</data></item>"
            % (head, len(payload), encoded)).encode("utf-8")


def text_item(code, value):
    """A text item, or nothing at all when the value is empty.

    owntone ignores an item whose payload is empty, so sending one is only
    noise -- but worse, it would not clear a stale value either. Skipping keeps
    the intent honest: nothing is being said about this field.
    """
    if not value:
        return b""
    return item(TYPE_CORE, code, value.encode("utf-8"))


def progress_item(position_ms, duration_ms, sample_rate):
    """A prgr item in frames, 1-based so no component is ever zero."""
    if duration_ms <= 0:
        return b""

    start = 1
    position = start + int(round(max(0, position_ms) * sample_rate / 1000.0))
    end = start + int(round(duration_ms * sample_rate / 1000.0))
    if end <= start:
        return b""

    payload = "%d/%d/%d" % (start, position, end)
    return item(TYPE_SSNC, CODE_PROGRESS, payload.encode("ascii"))


def picture_item(data):
    """A PICT item, if the bytes are something owntone will accept."""
    if not data or len(data) < 2 or len(data) > PICTURE_SIZE_MAX:
        return b""
    # owntone sniffs the format itself and rejects anything but these two.
    if not (data[:2] == b"\xff\xd8" or data[:2] == b"\x89P"):
        return b""
    return item(TYPE_SSNC, CODE_PICTURE, data)


def flush_item():
    return item(TYPE_SSNC, CODE_FLUSH)


def fetch_cover(covers, timeout, log):
    """The first cover librespot offered, fetched as bytes.

    COVERS is newline-separated and ordered largest first, which is what we
    want: owntone scales for its clients, and a 640px JPEG is far below the
    1 MiB ceiling.
    """
    for url in [line.strip() for line in covers.split("\n") if line.strip()]:
        if not url.startswith(("http://", "https://")):
            continue
        try:
            with urllib.request.urlopen(url, timeout=timeout) as response:
                return response.read(PICTURE_SIZE_MAX + 1)
        except Exception as exc:  # noqa: BLE001 -- artwork is never worth failing over
            log("could not fetch cover %s: %s" % (url, exc))
    return None


def cover_path(state_dir, track_id):
    safe = "".join(ch for ch in track_id if ch.isalnum()) or "current"
    return os.path.join(state_dir, "cover-%s.img" % safe)


def cache_cover(state_dir, track_id, data, log):
    """Keep the fetched cover on disk.

    A track's items may have to be sent more than once (see `delivered`), and
    re-fetching the same image over the network each time would be wasteful and
    could fail the second time round.
    """
    if not data:
        return None
    try:
        os.makedirs(state_dir, exist_ok=True)
        path = cover_path(state_dir, track_id)
        temp = "%s.%d.tmp" % (path, os.getpid())
        with open(temp, "wb") as handle:
            handle.write(data)
        os.replace(temp, path)
        return path
    except OSError as exc:
        log("could not cache cover: %s" % exc)
        return None


def load_cover(path):
    if not path:
        return None
    try:
        with open(path, "rb") as handle:
            return handle.read(PICTURE_SIZE_MAX + 1)
    except OSError:
        return None


def prune_covers(state_dir, keep):
    """Drop every cached cover but the current one."""
    try:
        for name in os.listdir(state_dir):
            if name.startswith("cover-") and os.path.join(state_dir, name) != keep:
                os.remove(os.path.join(state_dir, name))
    except OSError:
        pass


def env(name, default=""):
    return os.environ.get(name, default)


def joined(name, separator=", "):
    """A newline-joined librespot list, rejoined for humans."""
    parts = [part.strip() for part in env(name).split("\n") if part.strip()]
    return separator.join(parts)


# --- state -------------------------------------------------------------------
#
# Only track_changed carries DURATION_MS, but every position event needs it to
# build a prgr item. So the duration is remembered between invocations -- this
# program runs once per event and keeps nothing else in memory.


def default_state_dir():
    override = env("TUTTI_STATE_DIR")
    if override:
        return override

    home = os.path.expanduser("~")
    mac_caches = os.path.join(home, "Library", "Caches")
    if os.path.isdir(mac_caches):
        return os.path.join(mac_caches, "Tutti", "librespot-metadata")

    base = env("XDG_CACHE_HOME") or os.path.join(home, ".cache")
    return os.path.join(base, "tutti", "librespot-metadata")


def load_state(state_dir):
    try:
        with open(os.path.join(state_dir, "current-track.json"), "r") as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return {}


def save_state(state_dir, state):
    """Written via a temp file so a concurrent reader never sees half a file."""
    try:
        os.makedirs(state_dir, exist_ok=True)
        path = os.path.join(state_dir, "current-track.json")
        temp = "%s.%d.tmp" % (path, os.getpid())
        with open(temp, "w") as handle:
            json.dump(state, handle)
        os.replace(temp, path)
    except OSError:
        pass  # State is an optimisation; losing it costs a progress bar.


# --- pipe --------------------------------------------------------------------


def write_blob(pipe_path, blob, timeout, log):
    """Write to the metadata pipe without ever blocking indefinitely.

    Opened O_NONBLOCK so that a pipe with no reader fails immediately with ENXIO
    instead of hanging. That is the normal state before playback starts, and
    librespot waits on this program, so a blocking open here would stall the
    player.
    """
    try:
        fd = os.open(pipe_path, os.O_WRONLY | os.O_NONBLOCK)
    except FileNotFoundError:
        log("no metadata pipe at %s (run --setup)" % pipe_path)
        return False
    except OSError as exc:
        if exc.errno == errno.ENXIO:
            log("nothing reading %s yet; owntone watches it once playback starts"
                % pipe_path)
            return False
        log("could not open %s: %s" % (pipe_path, exc))
        return False

    try:
        deadline = time.monotonic() + timeout
        view = memoryview(blob)
        while view:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                log("timed out writing to %s" % pipe_path)
                return False
            _, writable, _ = select.select([], [fd], [], remaining)
            if not writable:
                continue
            try:
                view = view[os.write(fd, view):]
            except BlockingIOError:
                continue
            except BrokenPipeError:
                log("owntone closed %s mid-write" % pipe_path)
                return False
    finally:
        os.close(fd)

    return True


def ensure_pipe(pipe_path, log):
    if os.path.exists(pipe_path):
        return True
    try:
        os.makedirs(os.path.dirname(pipe_path) or ".", exist_ok=True)
        os.mkfifo(pipe_path, 0o600)
        log("created %s" % pipe_path)
        return True
    except OSError as exc:
        log("could not create %s: %s" % (pipe_path, exc))
        return False


# --- events ------------------------------------------------------------------


POSITION_EVENTS = ("playing", "paused", "seeked", "position_correction")


def track_items(args, state, position_ms):
    """Everything owntone needs in order to describe the current track."""
    blob = flush_item()
    blob += text_item(CODE_TITLE, state.get("title", ""))
    blob += text_item(CODE_ARTIST, state.get("artist", ""))
    blob += text_item(CODE_ALBUM, state.get("album", ""))
    if not args.no_artwork:
        blob += picture_item(load_cover(state.get("cover_path")))
    blob += progress_item(position_ms, int(state.get("duration_ms") or 0), args.sample_rate)
    return blob


def remember_track(args, state, state_dir, log):
    title = env("NAME")
    album = env("ALBUM")
    artist = joined("ARTISTS")

    # Podcasts carry no artists or album; the show is the useful stand-in.
    if env("ITEM_TYPE") == "Episode":
        show = env("SHOW_NAME")
        artist = artist or show
        album = album or show

    track_id = env("TRACK_ID")
    path = None
    if not args.no_artwork:
        path = cache_cover(state_dir, track_id,
                           fetch_cover(env("COVERS"), args.artwork_timeout, log), log)
    prune_covers(state_dir, path)

    state.clear()
    state.update({
        "track_id": track_id,
        "duration_ms": int(env("DURATION_MS", "0") or 0),
        "title": title,
        "artist": artist,
        "album": album,
        "cover_path": path,
        # Set once the items have actually reached owntone. Until then every
        # later event is a chance to try again -- see build().
        "delivered": False,
    })


def build(args, state, state_dir, log):
    """The items for this event, and whether they describe the whole track.

    owntone only starts watching the metadata pipe once playback begins, so the
    track_changed that announces a track usually arrives before there is anyone
    to read it. That send is dropped, and the track would otherwise play with no
    title at all. So the description is kept until something confirms it landed,
    and the next event re-sends it.
    """
    event = args.event or env("PLAYER_EVENT")

    if event == "track_changed":
        remember_track(args, state, state_dir, log)
        return event, track_items(args, state, 0), True

    if event in POSITION_EVENTS:
        position_ms = int(env("POSITION_MS", "0") or 0)
        if state.get("track_id") and not state.get("delivered"):
            log("earlier metadata never reached owntone; sending it again")
            return event, track_items(args, state, position_ms), True
        return event, progress_item(
            position_ms, int(state.get("duration_ms") or 0), args.sample_rate), False

    if event in ("stopped", "end_of_track"):
        prune_covers(state_dir, None)
        state.clear()
        return event, flush_item(), False

    return event, b"", False


# --- entry point -------------------------------------------------------------


def resolve_pipe(args):
    if args.metadata_pipe:
        return args.metadata_pipe
    if env("TUTTI_METADATA_PIPE"):
        return env("TUTTI_METADATA_PIPE")

    audio = args.audio_pipe or env("TUTTI_AUDIO_PIPE")
    if audio:
        return "%s.metadata" % audio
    return None


def parse_args(argv):
    parser = argparse.ArgumentParser(
        prog="librespot-metadata",
        description="Bridge librespot player events into owntone's Shairport metadata pipe.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--audio-pipe", metavar="PATH",
                        help="librespot's PCM pipe; metadata goes to PATH.metadata "
                             "(env: TUTTI_AUDIO_PIPE)")
    parser.add_argument("--metadata-pipe", metavar="PATH",
                        help="the metadata pipe itself, overriding --audio-pipe "
                             "(env: TUTTI_METADATA_PIPE)")
    parser.add_argument("--sample-rate", type=int, default=DEFAULT_SAMPLE_RATE,
                        metavar="HZ",
                        help="must match owntone's library.pipe_sample_rate "
                             "(default: %d)" % DEFAULT_SAMPLE_RATE)
    parser.add_argument("--state-dir", metavar="DIR",
                        help="where the current track's duration is remembered "
                             "(env: TUTTI_STATE_DIR)")
    parser.add_argument("--event", metavar="NAME",
                        help="handle this event instead of $PLAYER_EVENT, for testing")
    parser.add_argument("--no-artwork", action="store_true",
                        help="skip the cover fetch, which is the only network call here")
    parser.add_argument("--artwork-timeout", type=float, default=5.0, metavar="SECONDS",
                        help="give up on the cover after this long (default: 5)")
    parser.add_argument("--write-timeout", type=float, default=2.0, metavar="SECONDS",
                        help="give up writing to the pipe after this long (default: 2)")
    parser.add_argument("--setup", action="store_true",
                        help="create the metadata pipe if missing, then exit")
    parser.add_argument("--dry-run", action="store_true",
                        help="print the items to stdout instead of writing the pipe")
    parser.add_argument("--verbose", action="store_true",
                        help="explain what happened, on stderr")
    return parser.parse_args(argv)


def main(argv):
    args = parse_args(argv)

    def log(message):
        if args.verbose:
            sys.stderr.write("librespot-metadata: %s\n" % message)

    pipe_path = resolve_pipe(args)
    if not pipe_path:
        sys.stderr.write(
            "librespot-metadata: no pipe given; pass --audio-pipe or set "
            "TUTTI_AUDIO_PIPE\n")
        return 1

    if args.setup:
        return 0 if ensure_pipe(pipe_path, log) else 1

    state_dir = args.state_dir or default_state_dir()
    state = load_state(state_dir)

    event, blob, carries_track = build(args, state, state_dir, log)

    if not blob:
        save_state(state_dir, state)
        log("nothing to send for event %r" % (event or "<unset>"))
        return 0

    if args.dry_run:
        save_state(state_dir, state)
        sys.stdout.write(blob.decode("utf-8", errors="replace"))
        sys.stdout.write("\n")
        return 0

    log("sending %d bytes for %s" % (len(blob), event))
    delivered = write_blob(pipe_path, blob, args.write_timeout, log)

    # Only a confirmed write retires the track description. If nothing was
    # reading, the next event picks it up again.
    if delivered and carries_track:
        state["delivered"] = True
    save_state(state_dir, state)

    # A failed write is not a failed event: before playback there is deliberately
    # no reader, and librespot should not see this program fail for that.
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

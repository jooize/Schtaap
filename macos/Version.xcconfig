// Shared version settings -- the single source of truth for every target.
// Referenced from project.yml as a project-level configFile, so target build
// settings must not carry MARKETING_VERSION or CURRENT_PROJECT_VERSION.
//
// The marketing version is the SemVer core, X.Y.Z, and the release tag is
// v<MARKETING_VERSION>; the release workflow refuses any tag that disagrees.
// CFBundleShortVersionString allows only digits and dots, so a pre-release
// is a 0.y.z version, never a suffix.

MARKETING_VERSION = 0.1.0

// The build number is the version. Launch Services and Sparkle order copies
// of an app by CFBundleVersion alone (measured 2026-09-08: the copy with the
// higher build number wins whatever the version string says), so making the
// build number the version makes them order by the version. It increases
// across releases as Apple requires for macOS, it needs no counter and no
// git, and the same commit gives the same value everywhere, which is what
// the reproducible release build needs. The one rule it asks for: never
// publish two builds of one version. A rebuilt release is a new patch.
//
// Debug builds are 0, so a development build never outranks an installed
// release when Launch Services has to choose between them.
CURRENT_PROJECT_VERSION = $(MARKETING_VERSION)
CURRENT_PROJECT_VERSION[config=Debug] = 0

// Which commit was built, for humans: Info.plist GitCommit. Written by the
// "Stamp Commit" scheme pre-action, which runs early enough to be read here.
// Optional include: absent on a clean checkout, "unknown" without git.
#include? "Commit.xcconfig"

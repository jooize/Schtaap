// Shared version settings -- the single source of truth for every target.
// Referenced from project.yml as a project-level configFile, so target build
// settings must not carry MARKETING_VERSION or CURRENT_PROJECT_VERSION.

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// Auto-generated by the "Bump Build Number" scheme pre-action, which runs
// early enough to override CURRENT_PROJECT_VERSION before Info.plist is
// processed. Optional include: absent on a clean checkout.
#include? "BuildNumber.xcconfig"

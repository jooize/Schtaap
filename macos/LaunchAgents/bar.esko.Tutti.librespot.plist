<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    The Spotify Connect half of the engine: it advertises this Mac as a
    speaker and writes raw PCM into the named pipe OwnTone reads.

    The name shown in Spotify is not here. It lives in engine.json under
    Application Support, which the app rewrites when the user edits it; the
    agent is then restarted to pick it up. Putting it in argv would mean
    rewriting and re-registering this plist on every edit.

    See the owntone plist for why the file name carries the bundle
    identifier.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>bar.esko.Tutti.librespot</string>

	<key>BundleProgram</key>
	<string>Contents/MacOS/EngineHelper</string>

	<key>ProgramArguments</key>
	<array>
		<string>Contents/MacOS/EngineHelper</string>
		<string>librespot</string>
	</array>

	<!--
	    The engine lives as long as the app does: the app starts the agents
	    when it launches (launchctl kickstart) and stops them when it quits
	    (launchctl kill TERM), so quitting the app frees the speakers and
	    leaves nothing advertised. So no RunAtLoad, and a KeepAlive that only
	    brings back a crash: the helper dies by the engine's own signal when
	    the engine crashes, and exits 0 when it was asked to stop, which is
	    the difference launchd needs.
	-->
	<key>RunAtLoad</key>
	<false/>

	<key>KeepAlive</key>
	<dict>
		<key>Crashed</key>
		<true/>
	</dict>

	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>

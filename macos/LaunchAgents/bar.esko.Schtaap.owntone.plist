<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    The AirPlay 2 half of the engine, registered by the app through
    SMAppService.agent(plistName:).

    The file name must equal the Label, and both carry the bundle
    identifier, so renaming the app means renaming this file too. That is
    one of two places the branding rule in project.yml cannot reach:
    launchd labels have to be unique across the system, and the reverse-DNS
    identifier is what makes them so. The other is the program path below,
    which carries the helper bundle's name (ENGINE_PRODUCT_NAME).

    BundleProgram is resolved relative to the app bundle, which is the only
    reason this plist can stay static. Every other path -- config, database,
    web root, log -- is computed by the helper at launch. See
    macos/Helper/main.swift.

    The helper is an app bundle of its own inside Contents/Helpers, so that
    macOS names the engine's Local Network prompt from its Info.plist rather
    than from the executable's file name. The path here is the executable
    inside that bundle.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>bar.esko.Schtaap.owntone</string>

	<key>BundleProgram</key>
	<string>Contents/Helpers/Schtaap Engine.app/Contents/MacOS/Schtaap Engine</string>

	<key>ProgramArguments</key>
	<array>
		<string>Contents/Helpers/Schtaap Engine.app/Contents/MacOS/Schtaap Engine</string>
		<string>owntone</string>
	</array>

	<!--
	    The engine lives as long as the app does: the app starts the agents
	    when it launches (launchctl kickstart) and stops them when it quits
	    (launchctl kill TERM), so quitting the app frees the speakers and
	    leaves nothing advertised. So no RunAtLoad, and a KeepAlive that only
	    brings back a crash: the helper dies by the engine's own signal when
	    the engine crashes, and exits 0 when it was asked to stop, which is
	    the difference launchd needs.
	-->
	<key>RunAtLoad</key>
	<false/>

	<key>KeepAlive</key>
	<dict>
		<key>Crashed</key>
		<true/>
	</dict>

	<!--
	    Audio playback is latency-sensitive, and the default background
	    task policy is free to throttle CPU and I/O. Interactive opts out.
	-->
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>

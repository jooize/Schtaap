--- a/playback/src/mixer/softmixer.rs
+++ b/playback/src/mixer/softmixer.rs
@@ -1,6 +1,6 @@
 use super::VolumeGetter;
 use super::{MappedCtrl, VolumeCtrl};
-use super::{Mixer, MixerConfig};
+use super::{Mixer, MixerConfig, NoOpVolume};
 use librespot_core::Error;
 use portable_atomic::AtomicU64;
 use std::sync::Arc;
@@ -37,7 +37,14 @@
     }

     fn get_soft_volume(&self) -> Box<dyn VolumeGetter + Send> {
-        Box::new(SoftVolume(self.volume.clone()))
+        // A fixed volume control tracks the volume for the remotes and never
+        // scales the audio: something downstream applies it. Every other
+        // control is this mixer's own, so the player scales by it.
+        if matches!(self.volume_ctrl, VolumeCtrl::Fixed) {
+            Box::new(NoOpVolume)
+        } else {
+            Box::new(SoftVolume(self.volume.clone()))
+        }
     }
 }

--- a/src/inputs/pipe.c	2026-09-08 01:15:38
+++ b/src/inputs/pipe.c	2026-09-08 01:16:04
@@ -238,6 +238,27 @@
 {
   if (fd >= 0)
     close(fd);
+}
+
+// Reads and discards whatever the pipe still holds. Used when an input
+// stops: the writer has stopped by then, and what it writes next begins at
+// the position its own metadata names, so anything still queued is audio
+// from before the stop. Closing our fd does not drop it, because the watch
+// keeps another fd on the same pipe open, and it would be the first thing
+// read at the next start and heard out of order: after a pause, a third of
+// a second from ahead of the pause point, then the resume proper.
+static void
+pipe_drain(int fd)
+{
+  char buf[PIPE_READ_MAX];
+  ssize_t ret;
+
+  if (fd < 0)
+    return;
+
+  do
+    ret = read(fd, buf, sizeof(buf));
+  while (ret > 0);
 }
 
 static int
@@ -1074,6 +1095,7 @@
   if (source->evbuf)
     evbuffer_free(source->evbuf);
 
+  pipe_drain(pipe->fd);
   pipe_close(pipe->fd);
 

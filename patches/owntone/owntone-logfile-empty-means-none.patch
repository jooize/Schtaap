     logformat = cfg_getstr(cfg_getsec(cfg, "general"), "logformat");
   logfile = cfg_getstr(cfg_getsec(cfg, "general"), "logfile");
+  if (logfile && !*logfile)
+    logfile = NULL;
 
   ret = logger_init(logfile, logdomains, loglevel, logformat);

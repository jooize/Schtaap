+static bool
+device_has_address(struct output_device *device, const char *address)
+{
+  if (device->v4_address && strcmp(address, device->v4_address) == 0)
+    return true;
+  if (device->v6_address && strcmp(address, device->v6_address) == 0)
+    return true;
+
+  return false;
 }
 
+// Like speaker_get_byactiveremote(), but only matches a speaker that also has
+// the given address, so that a request carrying a speaker's Active-Remote can
+// be checked to actually come from that speaker
 static enum command_state
+speaker_get_byactiveremote_address(void *arg, int *retval)
+{
+  struct speaker_get_param *spk_param = arg;
+  struct output_device *device;
+  int i;
+
+  for (device = outputs_list(), i = 0; device; device = device->next, i++)
+    {
+      if ((uint32_t)device->id == spk_param->active_remote && device_has_address(device, spk_param->address))
+	{
+	  device_to_speaker_info(spk_param->spk_info, device, i);
+	  *retval = 0;
+	  return COMMAND_END;
+	}
+    }
+
+  *retval = -1;
+  return COMMAND_END;
+}

dacp: authorize a speaker's own requests without trusted_networks

An AirPlay 2 receiver reports its physical volume buttons back to the
sender over DACP (/ctrl-int/1/setproperty?dmcp.device-volume=...).
dacp_request_authorize() only accepted a trusted peer or a DAAP
session, so with `trusted_networks = { "localhost" }` every such
request was refused with 403 and the speaker's buttons never reached
the player. The workaround, listing the speaker's address in
trusted_networks, also opens the JSON API and DAAP to that address,
and goes stale whenever the address changes.

Accept a DACP request when it comes from a known output's address.
The player already knows every output's address, so nothing has to be
configured and an address change is picked up with the next mDNS
resolve. The exposure is the same as trusting the address, minus
everything that is not DACP.

A HomePod has also been seen sending its volume with an Active-Remote
that belongs to no session of ours (2037839826 for a device whose id
gives 3310982810), which made speaker_get() fail even when the
request was authorized. When the Active-Remote names no speaker, the
speaker at the request's own address is used.

--- a/src/httpd_dacp.c
+++ b/src/httpd_dacp.c
@@ -548,13 +548,21 @@
     }
 
   ret = player_speaker_get_byactiveremote(speaker_info, active_remote);
-  if (ret < 0)
+  if (ret == 0)
+    return 0;
+
+  // A HomePod has been seen reporting its volume buttons with an Active-Remote
+  // that belongs to no session of ours. The request still comes from the
+  // speaker's own address, and that is the speaker it is about.
+  ret = (hreq->peer_address) ? player_speaker_get_byaddress(speaker_info, hreq->peer_address) : -1;
+  if (ret == 0)
     {
-      DPRINTF(E_LOG, L_DACP, "'%s' request from '%s' has unknown Active-Remote: '%s'\n", req_name, hreq->peer_address, remote);
-      return -1;
+      DPRINTF(E_DBG, L_DACP, "'%s' request from '%s' has Active-Remote '%s', which is no session; using the speaker at that address, '%s'\n", req_name, hreq->peer_address, remote, speaker_info->name);
+      return 0;
     }
 
-  return 0;
+  DPRINTF(E_LOG, L_DACP, "'%s' request from '%s' has unknown Active-Remote: '%s'\n", req_name, hreq->peer_address, remote);
+  return -1;
 }
 
 static int
@@ -593,6 +601,28 @@
     DPRINTF(E_LOG, L_DACP, "Player returned an error for start after seek\n");
 }
 
+// A speaker we stream to reports its own volume buttons over DACP. Accept such
+// a request when it comes from a known speaker's address, so the speaker needs
+// no entry in trusted_networks: that would also open the JSON API and DAAP to
+// it, and go stale when its address changes.
+static bool
+dacp_request_is_from_speaker(struct httpd_request *hreq)
+{
+  struct player_speaker_info speaker_info;
+  int ret;
+
+  if (!hreq->peer_address)
+    return false;
+
+  ret = player_speaker_get_byaddress(&speaker_info, hreq->peer_address);
+  if (ret < 0)
+    return false;
+
+  DPRINTF(E_DBG, L_DACP, "Request '%s' is from speaker '%s' at '%s'\n", hreq->uri, speaker_info.name, hreq->peer_address);
+
+  return true;
+}
+
 static int
 dacp_request_authorize(struct httpd_request *hreq)
 {
@@ -601,6 +631,9 @@
   int ret;
 
   if (httpd_request_is_trusted(hreq))
+    return 0;
+
+  if (dacp_request_is_from_speaker(hreq))
     return 0;
 
   param = httpd_query_value_find(hreq->query, "session-id");

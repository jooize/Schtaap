+
+// A speaker we stream to reports its own volume buttons over DACP, identifying
+// itself with the Active-Remote we gave it in the RTSP session. Accept such a
+// request when it comes from that speaker's address, so the speaker needs no
+// entry in trusted_networks: that would also open the JSON API and DAAP to
+// it, and go stale when its address changes.
+static bool
+dacp_request_is_from_speaker(struct httpd_request *hreq)
+{
+  struct player_speaker_info speaker_info;
+  const char *remote;
+  uint32_t active_remote;
+  int ret;
+
+  if (!hreq->peer_address)
+    return false;
+
+  remote = httpd_header_find(hreq->in_headers, "Active-Remote");
+  if (!remote || (safe_atou32(remote, &active_remote) < 0))
+    {
+      DPRINTF(E_DBG, L_DACP, "Request '%s' from '%s' has no usable Active-Remote: '%s'\n", hreq->uri, hreq->peer_address, remote);
+      return false;
+    }
+
+  ret = player_speaker_get_byactiveremote_address(&speaker_info, active_remote, hreq->peer_address);
+  if (ret < 0)
+    {
+      DPRINTF(E_DBG, L_DACP, "Request '%s' from '%s' has Active-Remote %" PRIu32 ", which is no speaker at that address\n", hreq->uri, hreq->peer_address, active_remote);
+      return false;
+    }
+
+  DPRINTF(E_DBG, L_DACP, "Request '%s' is from speaker '%s' at '%s'\n", hreq->uri, speaker_info.name, hreq->peer_address);
+
+  return true;
 }
 

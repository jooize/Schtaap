--- a/src/outputs/airplay_events.c
+++ b/src/outputs/airplay_events.c
@@ -38,6 +38,7 @@
 #include "misc.h"
 #include "logger.h"
 #include "player.h"
+#include "listener.h"
 #include "pair_ap/pair.h"
 
 #define RTSP_VERSION "RTSP/1.0"
@@ -332,6 +333,31 @@
 handle_event(enum airplay_events event)
 {
   struct player_status status;
+
+  // The player's source is a pipe fed by another process. Pausing closes and
+  // reopens the pipe, which the writer sees as EPIPE and dies of, and playing
+  // again restarts the item from position 0. Next and previous mean nothing
+  // inside a pipe. So the speaker's own transport controls are not applied
+  // here: pause and play are handed to listeners (the websocket carries them
+  // as "remote_pause" and "remote_play") for the client driving this server
+  // to act on, and next and previous are dropped.
+  switch (event)
+    {
+      case AIRPLAY_EVENT_PAUSE:
+	DPRINTF(E_INFO, L_AIRPLAY, "Speaker asked to pause, notifying listeners\n");
+	listener_notify(LISTENER_REMOTE_PAUSE);
+	return;
+      case AIRPLAY_EVENT_PLAY:
+	DPRINTF(E_INFO, L_AIRPLAY, "Speaker asked to play, notifying listeners\n");
+	listener_notify(LISTENER_REMOTE_PLAY);
+	return;
+      case AIRPLAY_EVENT_NEXT:
+      case AIRPLAY_EVENT_PREV:
+	DPRINTF(E_INFO, L_AIRPLAY, "Dropping next/previous from speaker, the source is a pipe\n");
+	return;
+      default:
+	break;
+    }
 
   player_get_status(&status);
 

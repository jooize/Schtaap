+    /// A play with nothing loaded, which is where a context ends with
+    /// autoplay off, does what Spotify's own play button does there: the
+    /// context again from the top. Only a Connect load can start one, so
+    /// a plain play from a remote (a speaker's tap, our control socket)
+    /// did nothing at all in that state.
+    async fn handle_play_or_restart(&mut self) -> Result<(), Error> {
+        if !matches!(self.play_status, SpircPlayStatus::Stopped) {
+            self.handle_play();
+            return Ok(());
+        }
+        let context_uri = self.connect_state.context_uri().clone();
+        if context_uri.is_empty() {
+            return Ok(());
+        }
+        info!("play while stopped: starting <{context_uri}> again from the top");
+        let options = LoadRequestOptions {
+            start_playing: true,
+            ..Default::default()
+        };
+        self.handle_load(LoadRequest::from_context_uri(context_uri, options), None, None)
+            .await
+    }

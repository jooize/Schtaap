+
+// Compares two addresses ignoring any "%scope" suffix, since a link-local
+// address arrives with a scope from some sources and without from others
+static bool
+address_matches(const char *address, const char *candidate)
+{
+  size_t len;
 
+  if (!address || !candidate)
+    return false;
+
+  len = strcspn(address, "%");
+  if (strcspn(candidate, "%") != len)
+    return false;
+
+  return strncmp(address, candidate, len) == 0;
+}
+
 static enum command_state

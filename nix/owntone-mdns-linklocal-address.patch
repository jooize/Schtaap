-      match_v6 = device->v6_address && (strcmp(spk_param->address, device->v6_address) == 0);
+      match_v4 = address_matches(spk_param->address, device->v4_address);
+      match_v6 = address_matches(spk_param->address, device->v6_address) || address_matches(spk_param->address, device->v6_address_ll);
       if (match_v4 || match_v6)
 	{

.tmp/
.agents-work/
.trash/
result*

# Lima runtime state: multi-gigabyte disk images, generated SSH keys, per-run
# logs, pids and sockets. All of it is regenerated by `./lima start` from
# spotifytohomepod.yaml, provision.sh and the network config kept below.
.lima/*
!.lima/_config/
.lima/_config/*
!.lima/_config/networks.yaml

# macOS app build output. Tutti.xcodeproj and macos/Info.plist are generated
# by XcodeGen but committed, so a clone builds without it.
macos/.build/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcodeproj/project.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist

# Generated by the Bump Build Number scheme pre-action.
macos/.build-number
macos/.last-version
macos/BuildNumber.xcconfig

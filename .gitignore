.tmp/
.agents-work/
.trash/
result*

# Xcode derived data for the macOS app (Build, Index.noindex, Logs,
# ModuleCache), passed as -derivedDataPath. Schtaap.xcodeproj and
# macos/Info.plist are generated by XcodeGen but committed, so a clone
# builds without it.
macos/DerivedData/

# The bundled engine payload: owntone, librespot and their relocated dylib
# closure, ~25 MB of Mach-O. Rebuilt from the flake by macos/build-engine,
# so it is derived, not source, and no binary belongs in git history.
macos/Engine/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcodeproj/project.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist

# Generated by the Stamp Commit scheme pre-action.
macos/Commit.xcconfig
